    {
      "name": "📈 Demand Trends",
      "description": "Demand index is auto-populated every 6 hours via HuggingFace FinBERT sentiment analysis.\nManually add records here if you want to override the automated values.",
      "item": [
        {
          "name": "Add Demand Trend",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "if (json.data && json.data.id) {",
                "  pm.collectionVariables.set('trendId', json.data.id);",
                "  console.log('trendId set to', json.data.id);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/demand-trends",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Toyota\",\n  \"model\": \"Camry\",\n  \"year\": 2020,\n  \"month\": 8,\n  \"demandIndex\": 75.5,\n  \"searchVolume\": 12000,\n  \"avgDaysToSell\": 18,\n  \"region\": \"Mumbai\"\n}"
            }
          }
        },
        {
          "name": "Get All Trends",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/demand-trends"
          }
        },
        {
          "name": "Get Trend By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/demand-trends/{{trendId}}"
          }
        },
        {
          "name": "Search Trends by Make & Model",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/demand-trends/search?make=Toyota&model=Camry",
              "query": [
                { "key": "make",  "value": "Toyota" },
                { "key": "model", "value": "Camry"  }
              ]
            }
          }
        },
        {
          "name": "Delete Trend",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/demand-trends/{{trendId}}"
          }
        }
      ]
    },

    {
      "name": "🏷️ New Car Prices",
      "description": "Auto-populated on startup and 1st of every month from seed/new-car-prices.json.\nManually add records here to override or extend.",
      "item": [
        {
          "name": "Add New Car Price",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "if (json.data && json.data.id) {",
                "  pm.collectionVariables.set('priceId', json.data.id);",
                "  console.log('priceId set to', json.data.id);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/new-car-prices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Toyota\",\n  \"model\": \"Camry\",\n  \"year\": 2024,\n  \"variant\": \"XSE V6\",\n  \"exShowroomPrice\": 1400000,\n  \"onRoadPrice\": 1550000,\n  \"effectiveFrom\": \"2024-01-01T00:00:00\"\n}"
            }
          }
        },
        {
          "name": "Get All New Car Prices",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/new-car-prices"
          }
        },
        {
          "name": "Get New Car Price By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/new-car-prices/{{priceId}}"
          }
        },
        {
          "name": "Get Latest On-Road Price",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/new-car-prices/latest?make=Toyota&model=Camry&year=2024",
              "query": [
                { "key": "make",  "value": "Toyota" },
                { "key": "model", "value": "Camry"  },
                { "key": "year",  "value": "2024"   }
              ]
            }
          }
        },
        {
          "name": "Delete New Car Price",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/new-car-prices/{{priceId}}"
          }
        }
      ]
    },

    {
      "name": "📉 Depreciation",
      "item": [
        {
          "name": "Add Depreciation Data",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "if (json.data && json.data.id) {",
                "  pm.collectionVariables.set('depreciationId', json.data.id);",
                "  console.log('depreciationId set to', json.data.id);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/depreciation",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Toyota\",\n  \"model\": \"Camry\",\n  \"ageYears\": 4,\n  \"mileageBand\": \"30001-60000\",\n  \"depreciationPercent\": 38.5,\n  \"fuelType\": \"Petrol\"\n}"
            }
          }
        },
        {
          "name": "Get All Depreciation Records",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/depreciation"
          }
        },
        {
          "name": "Get Depreciation By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/depreciation/{{depreciationId}}"
          }
        },
        {
          "name": "Calculate Depreciation %",
          "request": {
            "method": "GET",
            "description": "Returns the depreciation percentage for a specific make/model/age/fuel combination.\nFalls back to default values if no record exists.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/depreciation/calculate?make=Toyota&model=Camry&ageYears=4&fuelType=Petrol",
              "query": [
                { "key": "make",     "value": "Toyota" },
                { "key": "model",    "value": "Camry"  },
                { "key": "ageYears", "value": "4"      },
                { "key": "fuelType", "value": "Petrol" }
              ]
            }
          }
        },
        {
          "name": "Delete Depreciation Record",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/depreciation/{{depreciationId}}"
          }
        }
      ]
    },

    {
      "name": "🔮 Price Prediction",
      "item": [
        {
          "name": "Predict Car Price",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/predict",
            "description": "Aggregates all 6 factors and returns:\n- predictedPrice\n- priceRangeLow  (−10%)\n- priceRangeHigh (+10%)\n- confidenceScore (0–100 based on data availability)\n- factors breakdown (shows exactly what data was used)\n\nTip: add 'vin' to include condition score in the prediction.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Toyota\",\n  \"model\": \"Camry\",\n  \"year\": 2020,\n  \"mileage\": 30000,\n  \"condition\": \"Good\",\n  \"location\": \"Mumbai\",\n  \"fuelType\": \"Petrol\",\n  \"transmission\": \"Automatic\",\n  \"vin\": \"JTDBE32K123456789\"\n}"
            }
          }
        },
        {
          "name": "Predict — Without VIN (no condition score)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/predict",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Maruti\",\n  \"model\": \"Swift\",\n  \"year\": 2022,\n  \"mileage\": 12000,\n  \"condition\": \"Excellent\",\n  \"location\": \"Bangalore\",\n  \"fuelType\": \"Petrol\",\n  \"transmission\": \"Manual\"\n}"
            }
          }
        },
        {
          "name": "Predict — Validation Error (blank make)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/predict",
            "description": "Expects HTTP 400 with per-field error list",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"\",\n  \"model\": \"Camry\",\n  \"year\": 2020,\n  \"mileage\": 30000,\n  \"condition\": \"Good\",\n  \"location\": \"Mumbai\",\n  \"fuelType\": \"Petrol\",\n  \"transmission\": \"Automatic\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "🤖 Automation",
      "description": "Manually trigger the scheduled jobs without waiting for the cron.\n\nJobs run automatically:\n- New Car Prices  → on startup + 1st of every month\n- Demand Trends   → on startup + every 6 hours (calls HuggingFace FinBERT)\n- Competition     → daily at 6 AM (Jsoup scraper with synthetic fallback)",
      "item": [
        {
          "name": "Trigger All Jobs",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/automation/sync/all",
            "description": "Runs all three jobs in sequence:\n1. New car price sync (seed JSON + estimates)\n2. Competition scraper (Jsoup + synthetic fallback)\n3. Demand trend update (HuggingFace FinBERT + seasonal fallback)"
          }
        },
        {
          "name": "Trigger Competition Scraper",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/automation/scrape/competition",
            "description": "Runs the Jsoup competition scraper.\nAttempts CarDekho live scrape, falls back to synthetic market-realistic listings."
          }
        },
        {
          "name": "Trigger New Car Price Sync",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/automation/sync/new-car-prices",
            "description": "Loads seed/new-car-prices.json then generates estimates for any gaps.\nSkips if already synced this month."
          }
        },
        {
          "name": "Trigger Demand Trend Update",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/automation/sync/demand-trends",
            "description": "Calls HuggingFace FinBERT for each tracked make/model.\nFalls back to seasonality-aware synthetic index if API is unavailable."
          }
        }
      ]
    },

    {
      "name": "❤️ Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health",
            "description": "Returns overall app health including MongoDB connectivity status"
          }
        }
      ]
    }

  ]
}
