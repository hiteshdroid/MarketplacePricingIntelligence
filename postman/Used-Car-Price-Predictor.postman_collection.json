                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/competition",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Honda\",\n  \"model\": \"City\",\n  \"year\": 2021,\n  \"mileage\": 20000,\n  \"listingPrice\": 700000,\n  \"source\": \"OLX\",\n  \"location\": \"Delhi\",\n  \"condition\": \"Good\",\n  \"daysOnMarket\": 15\n}"
            }
          }
        },
        {
          "name": "Get All Listings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/competition"
          }
        },
        {
          "name": "Get Listing By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/competition/{{listingId}}"
          }
        },
        {
          "name": "Get Competition Summary",
          "request": {
            "method": "GET",
            "description": "Returns min/max/avg price and average days-on-market for a make/model/year",
            "url": {
              "raw": "{{baseUrl}}/api/v1/competition/summary?make=Honda&model=City&year=2021",
              "query": [
                { "key": "make",  "value": "Honda" },
                { "key": "model", "value": "City"  },
                { "key": "year",  "value": "2021"  }
              ]
            }
          }
        },
        {
          "name": "Delete Listing",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/competition/{{listingId}}"
          }
        }
      ]
    },

    {
      "name": "🔧 Vehicle Condition",
