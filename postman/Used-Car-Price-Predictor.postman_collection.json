{
  "info": {
    "name": "Used Car Price Predictor API",
    "description": "Complete Postman collection for the Used Car Price Predictor REST APIs.\n\n## Quick Start\n1. Set `baseUrl` variable to `http://localhost:8080`\n2. Run **🤖 Automation / Trigger All Jobs** first to seed DB\n3. Then run **Bulk Add Transactions** to add historical data\n4. Finally call **Predict Car Price** to see a prediction\n\n## Groups\n- 🚗 Transactions — single & bulk add, search, average price\n- 🏁 Competition — listings, summary stats\n- 🔧 Vehicle Condition — condition assessments by ID & VIN\n- 📈 Demand Trends — market demand index\n- 🏷️ New Car Prices — ex-showroom & on-road prices\n- 📉 Depreciation — depreciation records & calculator\n- 🔮 Price Prediction — main prediction endpoint\n- 🤖 Automation — manually trigger scheduled jobs\n- ❤️ Health — actuator health check",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:8080", "type": "string" },
    { "key": "transactionId", "value": "",                      "type": "string", "description": "Set after calling Add Transaction" },
    { "key": "listingId",     "value": "",                      "type": "string", "description": "Set after calling Add Competition Listing" },
    { "key": "conditionId",   "value": "",                      "type": "string", "description": "Set after calling Add Condition Assessment" },
    { "key": "trendId",       "value": "",                      "type": "string", "description": "Set after calling Add Demand Trend" },
    { "key": "priceId",       "value": "",                      "type": "string", "description": "Set after calling Add New Car Price" },
    { "key": "depreciationId","value": "",                      "type": "string", "description": "Set after calling Add Depreciation Data" }
  ],
  "item": [

    {
      "name": "🚗 Transactions",
      "item": [
        {
          "name": "Add Single Transaction",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "if (json.data && json.data.id) {",
                "  pm.collectionVariables.set('transactionId', json.data.id);",
                "  console.log('transactionId set to', json.data.id);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Toyota\",\n  \"model\": \"Camry\",\n  \"year\": 2020,\n  \"mileage\": 30000,\n  \"salePrice\": 850000,\n  \"location\": \"Mumbai\",\n  \"condition\": \"Good\",\n  \"fuelType\": \"Petrol\",\n  \"transmission\": \"Automatic\",\n  \"color\": \"White\"\n}"
            }
          }
        },
        {
          "name": "Bulk Add Transactions",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/transactions/bulk",
            "description": "Add multiple transactions in one call. Max 500 per request.\nFailed items are reported individually without blocking the rest.\nResponse HTTP 201 = all saved, HTTP 207 = partial success.",
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"make\": \"Toyota\",\n    \"model\": \"Camry\",\n    \"year\": 2020,\n    \"mileage\": 30000,\n    \"salePrice\": 850000,\n    \"location\": \"Mumbai\",\n    \"condition\": \"Good\",\n    \"fuelType\": \"Petrol\",\n    \"transmission\": \"Automatic\",\n    \"color\": \"White\"\n  },\n  {\n    \"make\": \"Honda\",\n    \"model\": \"City\",\n    \"year\": 2021,\n    \"mileage\": 18000,\n    \"salePrice\": 720000,\n    \"location\": \"Delhi\",\n    \"condition\": \"Excellent\",\n    \"fuelType\": \"Petrol\",\n    \"transmission\": \"CVT\",\n    \"color\": \"Silver\"\n  },\n  {\n    \"make\": \"Maruti\",\n    \"model\": \"Swift\",\n    \"year\": 2022,\n    \"mileage\": 12000,\n    \"salePrice\": 620000,\n    \"location\": \"Bangalore\",\n    \"condition\": \"Excellent\",\n    \"fuelType\": \"Petrol\",\n    \"transmission\": \"Manual\",\n    \"color\": \"Red\"\n  },\n  {\n    \"make\": \"Hyundai\",\n    \"model\": \"Creta\",\n    \"year\": 2021,\n    \"mileage\": 25000,\n    \"salePrice\": 1350000,\n    \"location\": \"Chennai\",\n    \"condition\": \"Good\",\n    \"fuelType\": \"Diesel\",\n    \"transmission\": \"Automatic\",\n    \"color\": \"Blue\"\n  },\n  {\n    \"make\": \"Toyota\",\n    \"model\": \"Innova\",\n    \"year\": 2019,\n    \"mileage\": 55000,\n    \"salePrice\": 1450000,\n    \"location\": \"Pune\",\n    \"condition\": \"Good\",\n    \"fuelType\": \"Diesel\",\n    \"transmission\": \"Manual\",\n    \"color\": \"White\"\n  }\n]"
            }
          }
        },
        {
          "name": "Get All Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/transactions"
          }
        },
        {
          "name": "Get Transaction By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/transactions/{{transactionId}}",
            "description": "transactionId is auto-set after calling Add Single Transaction"
          }
        },
        {
          "name": "Search Transactions by Make & Model",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/search?make=Toyota&model=Camry",
              "query": [
                { "key": "make",  "value": "Toyota" },
                { "key": "model", "value": "Camry"  }
              ]
            }
          }
        },
        {
          "name": "Get Average Sale Price",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/average-price?make=Toyota&model=Camry&year=2020",
              "query": [
                { "key": "make",  "value": "Toyota" },
                { "key": "model", "value": "Camry"  },
                { "key": "year",  "value": "2020"   }
              ]
            }
          }
        },
        {
          "name": "Delete Transaction",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/transactions/{{transactionId}}"
          }
        }
      ]
    },

    {
      "name": "🏁 Competition Analysis",
      "item": [
